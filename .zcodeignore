# ── knowledge-rag ──
.knowledge-rag/

# ── 操作系统 ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ──
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.swp
*.swo
*~
\#*\#
.#*
.history/

# ── Java / Maven (后端) ──
**/target/
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.log

# ── Node.js / 前端 ──
node_modules/
.npm
.yarn/
*.tsbuildinfo

# ── Next.js ──
.next/
.next/**

# ── 环境变量 (含敏感信息) ──
.env
.env.local
.env.*.local
!.env.example

# ── Docker / 数据 ──
data/
docker-compose.override.yml

# ── 测试 & 覆盖率 ──
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# ── 日志 ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 缓存 & 临时文件 ──
.cache/
.turbo/
.tmp/
temp/
tmp/

# ── 操作系统 & 工具临时文件 ──
*.bak
*.tmp
*.temp
*.orig

# ── Archive ──
*.zip
*.tar.gz
*.rar
*.7z



*.jks
*.p12
=======
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*




