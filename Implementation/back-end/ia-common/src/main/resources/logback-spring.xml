<?xml version="1.0" encoding="UTF-8"?>
<!--
  共享日志配置（ia-common）—— 所有服务统一：控制台 + 滚动文件，日志行带 traceId（%X{traceId}）。
  traceId 由 TraceIdFilter 写入 MDC；Logstash/ELK 以 grok 解析此格式关联全链路日志。
  仅 Spring Boot 运行时加载（logback-spring.xml）；非 Spring 的 H2 单测不受影响。
-->
<configuration>
    <springProperty scope="context" name="APP" source="spring.application.name" defaultValue="app"/>
    <property name="LOG_PATH" value="logs/${APP}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [tid:%X{traceId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
