<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nolazy</groupId>
        <artifactId>IcedAmericanoMall</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>verification-service</artifactId>
    <description>校验服务：验证码签发/校验（SMS/EMAIL）+ 人机验证（Geetest），无库表</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 共享库：异常体系 / ErrorCode / 脱敏工具 -->
        <dependency>
            <groupId>org.nolazy</groupId>
            <artifactId>ia-common</artifactId>
        </dependency>

        <!-- 第三方集成：人机验证（极验 Geetest）、验证码生成工具 -->
        <dependency>
            <groupId>org.nolazy</groupId>
            <artifactId>ia-integration</artifactId>
        </dependency>

        <!-- 跨服务契约：NotificationClient（投递验证码）、VerificationClient 的 DTO -->
        <dependency>
            <groupId>org.nolazy</groupId>
            <artifactId>ia-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 验证码状态存 Redis（不落库）：一次性消费 + 重发限流 + 失败计数 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Feign：调用 notification-service 投递验证码 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j-swagger.version}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>
</project>
