# ============================================
# IceAmericanoMall — 统一环境变量（Docker Compose + Spring Boot）
# 复制为 .env 后填入实际值
# ============================================
# 当服务容器化后，docker compose 会将此文件中的所有变量注入容器。
# Spring Boot application.yml 通过 ${VAR_NAME} 引用即可.
# 当前未容器化时，API 密钥需额外 export 到 shell（见下文说明）。
#
# ⚠️ .env 已加入 .gitignore，不会被提交

# ==================== 容器密码 ====================
MYSQL_ROOT_PASSWORD=changeit_root_2024
MYSQL_DATABASE=icedamericano_mall
MYSQL_USER=iamall
MYSQL_PASSWORD=changeit_user_2024
REDIS_PASSWORD=changeit_redis_2024
NACOS_AUTH_TOKEN=changeit_nacos_token_min_32_chars_long
# RabbitMQ 已迁移至 RocketMQ 5.3 — 无需 RabbitMQ 环境变量
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeit_minio_2024
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ==================== 第三方 API 密钥 ====================
# 微信支付
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/callback/wechat

# 阿里云短信
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=冰美式商城
ALIYUN_SMS_TEMPLATE_CODE=

# DeepSeek AI
DEEPSEEK_API_KEY=

# JWT 密钥库
KEYSTORE_PASSWORD=changeit_keystore_2024
KEY_PASSWORD=changeit_key_2024

