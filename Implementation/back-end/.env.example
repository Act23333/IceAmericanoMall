# ============================================
# IceAmericanoMall 环境变量模板
# 复制为 .env 后填入实际值
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=changeit_root_2024
MYSQL_DATABASE=icedamericano_mall
MYSQL_USER=iamall
MYSQL_PASSWORD=changeit_user_2024

# ---------- Redis ----------
REDIS_PASSWORD=changeit_redis_2024

# ---------- Nacos ----------
NACOS_AUTH_USERNAME=nacos_admin
NACOS_AUTH_PASSWORD=changeit_nacos_2024

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeit_mq_2024

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeit_minio_2024

# ---------- ElasticSearch ----------
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---------- 微服务通用 ----------
IA_DB_HOST=mysql
IA_DB_PORT=3306
IA_REDIS_HOST=redis
IA_REDIS_PORT=6379
IA_NACOS_HOST=nacos
IA_NACOS_PORT=8848

# ---------- 第三方平台（生产环境必填） ----------
# 微信支付
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/callback/wechat

# 阿里云短信
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=冰美式商城
ALIYUN_SMS_TEMPLATE_CODE=

# DeepSeek AI
DEEPSEEK_API_KEY=

# JWT 密钥库
KEYSTORE_PASSWORD=changeit_keystore_2024
KEY_PASSWORD=changeit_key_2024
