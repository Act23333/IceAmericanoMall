# ============================================
# IceAmericanoMall — Docker Compose 变量模板
# 复制为 .env 后填入实际密码（仅容器内部使用）
# ============================================
# ⚠️ 此文件仅用于 docker compose 启动容器
# ⚠️ 第三方 API 密钥不要放这里 → 通过 K8s Secret / Vault / 环境变量注入
# ⚠️ .env 文件已在 .gitignore 中，不会被提交

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=changeit_root_2024
MYSQL_DATABASE=icedamericano_mall
MYSQL_USER=iamall
MYSQL_PASSWORD=changeit_user_2024

# ---------- Redis ----------
REDIS_PASSWORD=changeit_redis_2024

# ---------- Nacos ----------
NACOS_AUTH_TOKEN=changeit_nacos_token_min_32_chars_long

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeit_mq_2024

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeit_minio_2024

# ---------- ElasticSearch ----------
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---------- XXL-Job ----------
XXL_JOB_ACCESS_TOKEN=changeit_xxl_token_2024
