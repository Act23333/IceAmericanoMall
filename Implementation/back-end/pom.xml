        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.11</mybatis-plus.version>
        <hutool.version>5.8.43</hutool.version>
        <mysql.version>9.3.0</mysql.version>
        <elasticsearch.version>7.17.25</elasticsearch.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <webmvc-swagger.version>2.8.8</webmvc-swagger.version>
        <webflux-swagger.version>2.6.0</webflux-swagger.version>
        <knife4j-swagger.version>4.5.0</knife4j-swagger.version>
        <knife4j-gateway-swagger.version>4.5.0</knife4j-gateway-swagger.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <jjwt.version>0.13.0</jjwt.version>
        <ia-common.version>1.0</ia-common.version>
        <ia-api.version>1.0</ia-api.version>
        <lombok.version>1.18.42</lombok.version>
    </properties>
    
