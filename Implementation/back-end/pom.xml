    <!--这段配置是 Maven 项目中对 Java 编译过程的精细化管控，核心作用是：统一声明 maven-compiler-plugin（Maven 编译插件）的版本，并指定项目编译时使用的 JDK 版本，且通过 pluginManagement 实现 “配置统一管理、子模块可继承” 的效果。-->
    <build>
        <!--统一声明 / 管控插件的版本和配置，但不会直接执行这个插件（只是 “定义规则”，不是 “执行规则”）。-->
        <pluginManagement>
            <plugins>
                <plugin>
<!--                    Maven 官方插件的固定组标识（所有官方插件的 groupId 都是这个）。-->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${maven.compiler.source}</source> <!-- depending on your project -->
                        <target>${maven.compiler.target}</target> <!-- depending on your project -->
                        <annotationProcessorPaths>
                            <!-- 先处理 Lombok,配置注解处理器，再处理 MapStruct -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- 可选：管理 Spring Boot Maven 插件版本 -->
<!--                <plugin>-->
<!--                    <groupId>org.springframework.boot</groupId>-->
<!--                    <artifactId>spring-boot-maven-plugin</artifactId>-->
<!--                    <version>${spring-boot.version}</version>-->
<!--                </plugin>-->

            </plugins>
        </pluginManagement>

