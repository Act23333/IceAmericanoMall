<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<!--    POM文件的格式说明书版本，4.0.0是maven2和3唯一有效的版本-->
    <modelVersion>4.0.0</modelVersion>
<!--    项目归属（组织/公司/团体）方：group（组 / 组织）+ Id（标识），即项目所属组织 / 公司 / 团队的唯一标`识。-->
    <groupId>org.nolazy</groupId>
<!--    项目名：artifact（产物 / 制品）+ Id（标识），即项目 / 模块的唯一-->
    <artifactId>IcedAmericanoMall</artifactId>
<!--    打包方式为pom。pom 是特殊类型，说明这个项目是 父工程 / 聚合工程-->
    <packaging>pom</packaging>
<!--    开始项目的版本号为1.0-->
    <version>1.0</version>

<!--    当前模块为整个项目的父模块，父工程，让它可以统一管理子模块-->
    <modules>
        <module>ia-common</module>
        <module>user-service</module>
        <module>authorization-service</module>
        <module>gate-service</module>
        <module>ia-api</module>
        <module>cart-service</module>
        <module>pay-service</module>
        <module>trade-service</module>
        <module>item-service</module>
        <module>logistics-service</module>
    </modules>

    <!--实现 Maven 的配置继承-->
    <parent>
        <!--表示这个父工程属于 Spring Boot 官方组织（org.springframework.boot 是 Spring Boot 所有官方构件的标准 groupId）。-->
        <groupId>org.springframework.boot</groupId>
        <!--Spring Boot 专门为普通项目提供的 “基础父工程-->
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--表示继承的 Spring Boot 父工程版本是 3.5.4，这直接决定了你项目中所有 Spring Boot 核心依赖的版本-->
        <version>3.5.4</version>
        <!--指定父工程的 pom.xml 文件在本地的相对路径。-->
<!--        <relativePath/>-->
    </parent>
    <repositories>
        <!--阿里云镜像-->
        <repository>
            <id>alimaven</id>
            <name>aliyun maven</name>
            <url>https://maven.aliyun.com/nexus/content/groups/public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <properties>
        <java.version>21</java.version>
        <!--限制java代码版本，可以使用java21版本及以下的语法-->
        <maven.compiler.source>21</maven.compiler.source>
        <!--指定编译生成的字节码文件的java版本，只能在java21及以上的JVM上运行-->
        <maven.compiler.target>21</maven.compiler.target>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
<!--        <org.projectlombok.version>1.18.32</org.projectlombok.version>-->
<!--        <spring-boot.version>3.5.4</spring-boot.version>-->
