<!--                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>-->
<!--                <version>${webflux-swagger.version}</version> &lt;!&ndash; 使用适合 Spring Boot 3 的版本 &ndash;&gt;-->
<!--            </dependency>-->
