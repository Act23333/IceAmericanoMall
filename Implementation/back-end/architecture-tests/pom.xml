<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.nolazy</groupId>
        <artifactId>IcedAmericanoMall</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>architecture-tests</artifactId>
    <packaging>jar</packaging>
    <name>architecture-tests</name>
    <description>
        架构规则守卫（ArchUnit，ADR-038/050/052）：四层依赖方向 / PO 边界 / adapter 边界 / ID 生成出口。
        不依赖任何业务模块（无需 Spring 上下文），通过 importPaths 扫描各模块 target/classes；
        Maven 构建顺序按父 POM modules 声明序（本模块置末），全量 reactor 构建天然满足前置编译。
    </description>

    <properties>
        <archunit.version>1.3.0</archunit.version>
        <javaparser.version>3.26.4</javaparser.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          真正的 Java 语法解析（ADR 记于 open-items §1.17「裁决 A：换解析器」）。

          为什么不再自写文本扫描：用 regex + 花括号计数去**近似** Java 语法分析，代价是
          「无穷的形态清单」（lambda / 匿名类 / switch / 字符串 / 字符字面量 / 文本块 /
          注解括号 / 跨行签名 / 泛型尖括号 / record / sealed / 嵌套类型）。实测已失效三次：
          payByBalance 的 3 个本地资金写被判 0（假阴性）、WalletManager#refund 解析不出、
          注解参数里的括号让方法被命名成 `Transactional`。每补一个形态就冒出下一个。

          版式锁：3.26.x（解析失败必须 orElseThrow，见 JavaSourceParser）。
        -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          ADR-062 §守卫 3（线格式标识字段的 JSON 往返性质测试，IdWireRoundTripTest）：
          需要 Jackson 把被测 DTO/VO 按线上命名策略（SNAKE_CASE）渲染/解析。
          ⚠ 仍**不依赖任何业务模块** —— 业务类由测试用 URLClassLoader 从各模块 target/classes
          装载（见该类注释），本处仅引入第三方库。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
