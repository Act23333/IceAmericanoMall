.page{padding-bottom:80rpx}.header{background:linear-gradient(180deg,#f7f6f3,#fafaf8);padding:80rpx 48rpx 64rpx}.header-title{color:#1a1a1a;font-size:56rpx;font-weight:300;letter-spacing:4rpx}.header-desc{color:#8c8a87;display:block;font-size:28rpx;margin-top:16rpx}.section{padding:48rpx 40rpx 0}.section-title{color:#1a1a1a;font-size:36rpx;font-weight:500;margin-bottom:32rpx}.category-grid{display:flex;flex-wrap:wrap;gap:20rpx}.category-item{align-items:center;display:flex;flex-direction:column;width:calc(33.33333% - 40rpx/3)}.category-icon{background:linear-gradient(135deg,rgba(74,124,89,.08),rgba(107,125,179,.04));border-radius:28rpx;height:110rpx;width:110rpx}.category-name{color:#2d2d2d;font-size:24rpx;margin-top:14rpx}.product-list{display:flex;flex-wrap:wrap;gap:20rpx}.product-card{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);overflow:hidden;padding-bottom:24rpx;width:calc(50% - 20rpx/2)}.product-image{aspect-ratio:1;background:linear-gradient(135deg,#f0efec,#fafaf8);width:100%}.product-name{color:#1a1a1a;display:block;font-size:28rpx;margin-top:20rpx;padding:0 24rpx}.product-price{color:#1a1a1a;display:block;font-size:32rpx;font-weight:600;margin-top:8rpx;padding:0 24rpx}