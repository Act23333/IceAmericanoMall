.page{padding-bottom:80rpx}.hero{align-items:center;background:linear-gradient(180deg,#f7f6f3,#e8e6e1);display:flex;flex-direction:column;padding:160rpx 64rpx 120rpx}.hero-title{color:#1a1a1a;font-size:80rpx;font-weight:300;letter-spacing:8rpx}.hero-tagline{color:#2d2d2d;font-size:32rpx;margin-top:32rpx}.hero-desc{color:#8c8a87;font-size:26rpx;margin-top:16rpx}.section{padding:60rpx 40rpx 0}.section-title{color:#1a1a1a;font-size:40rpx;font-weight:500;margin-bottom:40rpx}.category-grid{display:flex;flex-wrap:wrap;gap:24rpx}.category-item{align-items:center;display:flex;flex-direction:column;width:calc(33.33333% - 48rpx/3)}.category-icon{background:linear-gradient(135deg,rgba(74,124,89,.1),rgba(107,125,179,.06));border-radius:32rpx;height:120rpx;width:120rpx}.category-name{color:#2d2d2d;font-size:26rpx;margin-top:16rpx}.product-placeholder{align-items:center;background:hsla(45,12%,93%,.5);border-radius:32rpx;display:flex;flex-direction:column;padding:120rpx 0}.placeholder-text{color:#8c8a87;font-size:30rpx}.placeholder-hint{color:#b8b5b0;font-size:24rpx;margin-top:16rpx}