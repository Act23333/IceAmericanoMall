.page{padding-bottom:80rpx}.profile-header{align-items:center;background:linear-gradient(180deg,#f7f6f3,#fafaf8);display:flex;flex-direction:column;padding:120rpx 48rpx 80rpx}.avatar{background:linear-gradient(135deg,#e8e6e1,#f0efec);border:4rpx solid hsla(0,0%,100%,.8);border-radius:50%;height:140rpx;width:140rpx}.nickname{color:#1a1a1a;font-size:40rpx;font-weight:500;margin-top:32rpx}.login-hint{color:#4a7c59;font-size:28rpx;margin-top:16rpx}.menu-section{margin-top:40rpx;padding:0 40rpx}.menu-item{align-items:center;background:#fff;border-radius:28rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.03);display:flex;margin-bottom:20rpx;padding:40rpx 32rpx}.menu-icon{font-size:44rpx;text-align:center;width:80rpx}.menu-text{flex:1;margin-left:24rpx}.menu-title{color:#1a1a1a;font-size:32rpx}.menu-desc{color:#8c8a87;display:block;font-size:24rpx;margin-top:4rpx}.menu-arrow{color:#b8b5b0;font-size:36rpx}